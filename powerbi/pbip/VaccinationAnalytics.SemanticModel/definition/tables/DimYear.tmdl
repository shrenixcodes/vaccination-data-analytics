table DimYear

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	partition DimYear = m
		mode: import
		source =
				let
				    Years = List.Numbers(1974, 2026 - 1974 + 1),
				    ToTable = Table.FromList(Years, Splitter.SplitByNothing(), {"year"}),
				    Typed = Table.TransformColumnTypes(ToTable, {{"year", Int64.Type}})
				in
				    Typed

annotation PBI_ResultType = Table
